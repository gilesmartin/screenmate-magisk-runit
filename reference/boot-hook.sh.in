#!/system/bin/sh
# SPDX-License-Identifier: MIT
# Sanitized live reference, NOT an installer; production has not been changed.
if [ "${SCREENMATE_REVIEWED_REFERENCE:-}" != yes ]; then
    printf '%s\n' 'Inactive reference: review documentation and local policy capture first.' >&2
    exit 64
fi


# SCREENMATE-RUNIT-BOOT-V1
# Start independent supervisor without blocking VirtualAP.
# Create run/disable-boot to disable on subsequent boots.
if [ ! -e /data/local/screenmate-services/run/disable-boot ] &&
   [ -x /data/local/screenmate-services/start-supervisor.sh ]; then
    /data/local/screenmate-services/bin/busybox setsid \
        /data/local/screenmate-services/start-supervisor.sh \
        </dev/null \
        >>/data/local/screenmate-services/logs/boot.log 2>&1 &
fi
# END-SCREENMATE-RUNIT-BOOT-V1
